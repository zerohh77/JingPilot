<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.zerohh77.jingpilot.power</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HELPER__</string>
    <string>refresh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>27</integer>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Library/Logs/JingPilot/power-daemon.log</string>
  <key>StandardErrorPath</key>
  <string>/Library/Logs/JingPilot/power-daemon-error.log</string>
</dict>
</plist>
